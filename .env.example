# PostgreSQL (Neon / Vercel Postgres / Supabase)
# Pooled bağlantı — tətbiq üçün
DATABASE_URL="postgresql://user:password@host/naharim?sslmode=require"
# Birbaşa (unpooled) bağlantı — miqrasiyalar üçün. Pooler yoxdursa, DATABASE_URL ilə eyni ola bilər
DATABASE_URL_UNPOOLED="postgresql://user:password@host/naharim?sslmode=require"
# Ən azı 32 simvol, təsadüfi:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"
